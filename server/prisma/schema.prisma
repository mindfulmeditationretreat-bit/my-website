generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  user
  instructor
  admin
}

enum SubscriptionStatus {
  trialing
  active
  expired
  cancelled
}

enum ResourceType {
  pdf
  video
  audio
  image
  article
}

enum Category {
  diet
  meditation
  counseling
  general
}

enum ProgressType {
  weight
  meditation
  mood
}

model User {
  id                Int      @id @default(autoincrement())
  email             String   @unique @db.VarChar(255)
  passwordHash      String?  @map("password_hash") @db.VarChar(255)
  googleId          String?  @unique @map("google_id") @db.VarChar(255)
  role              Role     @default(user)
  fullName          String?  @map("full_name") @db.VarChar(255)
  age               Int?
  gender            String?  @db.VarChar(50)
  wellnessGoals     Json?    @map("wellness_goals")
  photoUrl          String?  @map("photo_url") @db.VarChar(500)
  bio               String?  @db.Text
  expertise         String?  @db.VarChar(255)
  availability      String?  @db.VarChar(255)
  address           String?  @db.VarChar(500)
  phone             String?  @db.VarChar(50)
  travelCountry     String?  @map("travel_country") @db.VarChar(255)
  notificationPrefs Json?    @map("notification_prefs")
  onboarded         Boolean  @default(false)
  emailVerified     Boolean  @default(false) @map("email_verified")
  active            Boolean  @default(true)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  subscriptions       Subscription[]       @relation("UserSubscriptions")
  instructedClients   Subscription[]       @relation("InstructorSubscriptions")
  passwordResetTokens PasswordResetToken[]
  verificationTokens  VerificationToken[]
  sentMessages        Message[]            @relation("SentMessages")
  receivedMessages    Message[]            @relation("ReceivedMessages")
  notifications       Notification[]
  progressEntries     ProgressEntry[]
  uploadedResources   Resource[]           @relation("UploadedResources")
  notes               InstructorNote[]     @relation("UserNotes")
  authoredNotes       InstructorNote[]     @relation("AuthorNotes")
  assignedResources   UserResource[]       @relation("UserResourceOwner")
  resourcesAssignedBy UserResource[]       @relation("UserResourceAssigner")

  @@index([role])
  @@map("users")
}

model Program {
  id          Int      @id @default(autoincrement())
  slug        String   @unique @db.VarChar(100)
  name        String   @db.VarChar(255)
  description String?  @db.Text
  features    Json?
  priceCents  Int      @default(0) @map("price_cents")
  currency    String   @default("NPR") @db.VarChar(10)
  trialDays   Int      @default(14) @map("trial_days")
  category    Category @default(general)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  subscriptions Subscription[]
  resources     Resource[]

  @@map("programs")
}

model Subscription {
  id                  Int                @id @default(autoincrement())
  userId              Int                @map("user_id")
  programId           Int                @map("program_id")
  instructorId        Int?               @map("instructor_id")
  status              SubscriptionStatus @default(trialing)
  trialStartedAt      DateTime?          @map("trial_started_at")
  trialEndsAt         DateTime?          @map("trial_ends_at")
  currentPeriodEnd    DateTime?          @map("current_period_end")
  trialEndingNotified Boolean            @default(false) @map("trial_ending_notified")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  user       User    @relation("UserSubscriptions", fields: [userId], references: [id], onDelete: Cascade)
  program    Program @relation(fields: [programId], references: [id])
  instructor User?   @relation("InstructorSubscriptions", fields: [instructorId], references: [id], onDelete: SetNull)
  messages   Message[]

  @@unique([userId, programId])
  @@index([status])
  @@map("subscriptions")
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  token     String    @unique @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model VerificationToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  token     String    @unique @db.VarChar(255)
  code      String?   @db.VarChar(10)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("verification_tokens")
}

model Resource {
  id          Int          @id @default(autoincrement())
  title       String       @db.VarChar(255)
  description String?      @db.Text
  type        ResourceType
  category    Category
  programId   Int?         @map("program_id")
  url         String?      @db.VarChar(1000)
  body        String?      @db.LongText
  isPremium   Boolean      @default(false) @map("is_premium")
  uploadedBy  Int?         @map("uploaded_by")
  createdAt   DateTime     @default(now()) @map("created_at")

  uploader       User?          @relation("UploadedResources", fields: [uploadedBy], references: [id], onDelete: SetNull)
  program        Program?       @relation(fields: [programId], references: [id], onDelete: SetNull)
  userAssignments UserResource[]

  @@index([category])
  @@index([type])
  @@index([programId])
  @@map("resources")
}

model UserResource {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  resourceId   Int      @map("resource_id")
  assignedById Int?     @map("assigned_by_id")
  note         String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  user       User     @relation("UserResourceOwner", fields: [userId], references: [id], onDelete: Cascade)
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  assignedBy User?    @relation("UserResourceAssigner", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([userId, resourceId])
  @@index([userId])
  @@map("user_resources")
}

model Message {
  id             Int       @id @default(autoincrement())
  senderId       Int       @map("sender_id")
  recipientId    Int       @map("recipient_id")
  subscriptionId Int?      @map("subscription_id")
  body           String?   @db.Text
  fileUrl        String?   @map("file_url") @db.VarChar(1000)
  fileName       String?   @map("file_name") @db.VarChar(255)
  readAt         DateTime? @map("read_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  sender       User          @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipient    User          @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([senderId, recipientId])
  @@index([recipientId, readAt])
  @@map("messages")
}

model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  type      String    @db.VarChar(100)
  title     String    @db.VarChar(255)
  body      String?   @db.Text
  link      String?   @db.VarChar(500)
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

model ProgressEntry {
  id         Int          @id @default(autoincrement())
  userId     Int          @map("user_id")
  type       ProgressType
  value      Float?
  note       String?      @db.Text
  recordedAt DateTime     @default(now()) @map("recorded_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, recordedAt])
  @@map("progress_entries")
}

model InstructorNote {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  authorId   Int      @map("author_id")
  body       String   @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  user   User @relation("UserNotes", fields: [userId], references: [id], onDelete: Cascade)
  author User @relation("AuthorNotes", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("instructor_notes")
}
