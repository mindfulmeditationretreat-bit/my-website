PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000
SERVER_ORIGIN=http://localhost:5000

DATABASE_URL="mysql://root:yourpassword@localhost:3306/mindful"

# Auth
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=7d
SESSION_SECRET=replace-this-with-another-long-random-string

# Google OAuth — create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: ${SERVER_ORIGIN}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP — Mailtrap for dev; on cPanel prefer mailbox SMTP or SMTP_SENDMAIL=true
# Do NOT use smtp.gmail.com on many shared cPanel hosts (TLS cert mismatch).
#   Option A: cPanel mailbox → mail.yourdomain.com or your host's SMTP :465
#   Option B: SMTP_SENDMAIL=true (local sendmail/exim)
#   Option C: RESEND_API_KEY (HTTPS)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Mindful <no-reply@yourdomain.com>"
SMTP_SENDMAIL=false
RESEND_API_KEY=

# File uploads — ImageKit (recommended for prod; leave blank to use local disk)
# Get credentials at https://imagekit.io → Settings → Developer Options → API Keys
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# Local disk fallback (used when Cloudinary creds are not set)
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=25

# eSewa (placeholder — fill before going live)
# Docs: https://developer.esewa.com.np/
ESEWA_MERCHANT_ID=
ESEWA_SECRET_KEY=
ESEWA_SUCCESS_URL=${CLIENT_ORIGIN}/dashboard/programs?payment=success
ESEWA_FAILURE_URL=${CLIENT_ORIGIN}/dashboard/programs?payment=failed
