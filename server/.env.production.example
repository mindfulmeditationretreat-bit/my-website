# === API on cPanel — copy to ~/api/.env (or set matching GitHub Actions secrets) ===
# Replace YOURDOMAIN with your real domain before going live.

PORT=5050
NODE_ENV=production
CLIENT_ORIGIN=https://YOURDOMAIN.com
SERVER_ORIGIN=https://api.YOURDOMAIN.com
COOKIE_DOMAIN=.YOURDOMAIN.com

DATABASE_URL=mysql://mindful1_ason:mindful12345@localhost:3306/mindful1_mindful

JWT_SECRET=304ac2bd275754d1fb46093f18725fd21cc18f068db51cdc7227f40ba6eb9cc914b93e40df0510e5bd022489be8bfd05
JWT_EXPIRES_IN=7d
SESSION_SECRET=2ea6d5fdabf1fe4c950f24743924113bb817862b2042e214655d45e62562ac68ffbcb7c1c30e49acf0cdb269bf95745d

# Optional — paste from local .env if you use Google login in prod
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Prefer sendmail on shared cPanel (Gmail SMTP often fails TLS there)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Mindful <noreply@YOURDOMAIN.com>"
SMTP_SENDMAIL=true

# Optional — ImageKit (else local uploads/)
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=25
