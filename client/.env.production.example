# === Frontend (cPanel Node / Next.js standalone) ===
# Set BEFORE `npm run build` (GitHub Actions sets these from secrets).
# Replace YOURDOMAIN with your real domain.

# Browser → public API (must end with /api)
NEXT_PUBLIC_API_URL=https://api.YOURDOMAIN.com/api

# Same-machine SSR → API (recommended on cPanel)
INTERNAL_API_URL=http://127.0.0.1:5050/api
